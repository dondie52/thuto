# Optional: HTTPS URL returning JSON (array of universities, or `{ "universities": [...] }`).
# Objects are merged into bundled `public/data/universities.json` by matching `id`.
# Must send CORS headers allowing your Thuto origin (e.g. Access-Control-Allow-Origin).
# VITE_UNIVERSITIES_REMOTE_URL=https://your-cdn.example.com/thuto/universities.json

# Public production URL used for canonicals, Open Graph URLs, robots.txt, and sitemap.xml.
# Include the deployed base path when using GitHub Pages.
# VITE_SITE_URL=https://dondie52.github.io/thuto/
# VITE_BASE_PATH=/thuto/
#
# For a custom root domain:
# VITE_SITE_URL=https://thuto.bw/
# VITE_BASE_PATH=/

# Optional: Gemini assistant flags. These are not secret keys.
# Real provider keys must live only in Supabase Edge Function secrets.
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=
# When AI is enabled, the signed-in home page can call the home-spotlight Edge Function (Gemini + optional Google Search).
# Set to false to keep only the local deterministic home picks. Keys still stay server-side in Supabase.
# VITE_AI_HOME_SPOTLIGHT=false

# Optional: Supabase project for community submissions and opportunity posts (see pillar2_community_data.md, docs/OPPORTUNITY_POSTS.md).
# If unset, community share/stats UI is hidden and internship/sponsor feeds show a “not connected” message.
# Apply migrations in supabase/migrations/ (or scripts/supabase-rls-policies.sql for submissions only), then test with the anon key only.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
#
# Google sign-in (Supabase Auth provider):
# 1. Supabase Dashboard → Authentication → Providers → Google (Client ID + Secret)
# 2. Google Cloud Console → OAuth client → Authorized redirect URI:
#    https://<project-ref>.supabase.co/auth/v1/callback
# 3. Supabase Dashboard → Authentication → URL Configuration → add redirect URLs, e.g.:
#    https://dondie52.github.io/thuto/auth
#    https://thuto.bw/auth
#    http://localhost:5173/thuto/auth
# For local Supabase CLI, set SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID and
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET, then enable [auth.external.google] in supabase/config.toml.

# Optional: Stripe publishable key (checkout uses hosted Stripe pages via edge functions).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Server-side only, set with Supabase CLI instead of this file:
# supabase secrets set GEMINI_API_KEY=your_gemini_key
# supabase secrets set AI_PROVIDER=gemini
# supabase secrets set GEMINI_MODEL=gemini-2.5-flash
#
# Scroll Feed moderation also uses Supabase Edge Function secrets.
# Apply supabase/migrations/20260530120000_scroll_feed.sql, deploy feed-moderation,
# and seed feed_admins with trusted user ids before launch.
# supabase functions deploy feed-moderation
